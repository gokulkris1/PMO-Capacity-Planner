{
  "name": "pmo-capacity-planner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "dev:demo": "vite --mode demo",
    "dev:api": "tsx scripts/local-api.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "check:guardrails": "node scripts/check-ui-guardrails.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:pure": "node scripts/check-pure.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:parity": "tsx scripts/db/parity.ts",
    "ci": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.21",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.570.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.7.0",
    "resend": "^6.34.1",
    "stripe": "^20.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.5",
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "uuid": "^13.0.2",
    "vite": "^6.2.0"
  }
}
