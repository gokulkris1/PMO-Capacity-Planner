# PMO Capacity Planner — environment variables (OPS-02). Copy to .env for local work; set the same names in
# Netlify → Project configuration → Environment variables for deploys. Never commit real values.
# GET /api/health reports which of these are set (booleans only).

# ── Required ─────────────────────────────────────────────────────────────────
# Postgres connection. The first one set wins: DATABASE_URL, NETLIFY_DATABASE_URL_UNPOOLED, NETLIFY_DATABASE_URL,
# NEON_DATABASE_URL. Use the direct (unpooled) Neon URL: migrations take an advisory lock.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
# NEON_DATABASE_URL=            # v1.1 name, still accepted

# Signs session tokens (HS256). Keep the value production already uses, or every user has to sign in again.
# Long random string; the API answers 503 instead of using a default when it is missing.
JWT_SECRET=
# Optional, for rotation: tokens signed with this secret are accepted too. Promote it to JWT_SECRET later.
JWT_SECRET_NEXT=

# AES-256-GCM key for Jira / Planview credentials: 32 random bytes, base64 (openssl rand -base64 32).
# Without it, existing (v1.1) secrets still decrypt but new ones cannot be saved (503).
INTEGRATIONS_ENC_KEY=

# ── Deployment mode ─────────────────────────────────────────────────────────
# internal = one company, every org on ENTERPRISE, no billing, sign-up closed by default; public = SaaS plans.
APP_MODE=internal
# Same value for the browser build.
VITE_APP_MODE=internal
# Public self-registration. Default: false in internal mode, true in public mode.
ALLOW_PUBLIC_SIGNUP=false
# Extra origins allowed to call the API with credentials (comma separated). The site's own URL
# (Netlify URL / DEPLOY_PRIME_URL / DEPLOY_URL) is always allowed.
ALLOWED_ORIGINS=
# Base URL used in emails and Stripe redirects. Defaults to Netlify's URL.
APP_URL=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without an email provider (Resend or Twilio, below) no email is sent: invitation links must be copied by hand and codes cannot be delivered.
RESEND_API_KEY=
# Or Twilio email (used when set): an API key and secret (preferred), or the account SID and auth token.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
FROM_EMAIL=PMO Capacity Planner <noreply@example.com>

# ── AI assistant (optional, off by default per org) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Billing (public mode only) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# ── Operations ──────────────────────────────────────────────────────────────
# debug | info | warn | error | silent (JSON logs to the function log)
LOG_LEVEL=info
# Outbound timeout for Jira/Planview calls in ms (capped at 8000 by the 10 s function limit).
INTEGRATIONS_FETCH_TIMEOUT_MS=7000

# ── Scripts only (never set on Netlify) ─────────────────────────────────────
# Destructive scripts (scripts/wipe_all.ts) refuse to run without ALLOW_DESTRUCTIVE=yes and against PROD_DB_HOST.
ALLOW_DESTRUCTIVE=
PROD_DB_HOST=
